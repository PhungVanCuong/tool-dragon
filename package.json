{
  "name": "dragon-city-hub",
  "version": "1.0.0",
  "description": "Dragon City Companion Platform - 100% Free, No Ads, No Key Required, Direct Connect",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build"
  },
  "keywords": [
    "dragon-city",
    "dragon-city-tool",
    "dragon-city-hub",
    "breeding-calculator",
    "heroic-race"
  ],
  "author": "Dragon City Community",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "uuid": "^11.1.0"
  }
}
